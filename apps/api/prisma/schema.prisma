generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================

enum EventStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RentalStatus {
  DRAFT
  ACTIVE
  RETURNED
  CANCELLED
}

// Define se a divergência foi porque sumiu ou porque quebrou
enum DivergenceType {
  MISSING
  DAMAGED
}

// Define se a divergência já foi resolvida (ex: cliente pagou pela cadeira quebrada)
enum DivergenceStatus {
  PENDING
  RESOLVED
}

// ================= MODELS =================

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  password          String   @unique
  tenantUuid        String   @default(uuid())
  responsibleEvents Event[]  @relation("EventResponsible")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  tenantUuid  String
  items       Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantUuid])
  @@map("categories")
}

model Client {
  id          String   @id @default(uuid())
  companyName String
  taxId       String   @unique
  contactName String?
  events      Event[]
  rentals     Rental[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Item {
  id                String   @id @default(uuid())
  name              String
  totalQuantity     Int      @default(0)
  availableQuantity Int      @default(0)
  unitCost          Decimal  @db.Decimal(10, 2)
  tenantUuid        String

  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  imageUrl          String?  @map("image_url")

  eventItems  EventItem[]
  rentalItems RentalItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([tenantUuid])
  @@map("items")
}

model Event {
  id            String      @id @default(uuid())
  eventName     String
  startDate     DateTime
  endDate       DateTime
  eventLocation String
  status        EventStatus @default(PLANNING)
  tenantUuid    String

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  responsibleId String?
  responsible   User?       @relation("EventResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  eventItems EventItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([responsibleId])
  @@map("events")
}

model EventItem {
  id               String   @id @default(uuid())
  plannedQuantity  Int
  shippedQuantity  Int      @default(0)
  returnedQuantity Int      @default(0)
  tenantUuid        String

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  divergences Divergence[] // Relacionamento com as divergências

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([itemId])
  @@map("event_items")
}

model Rental {
  id             String       @id @default(uuid())
  rentalCode     String
  startDate      DateTime
  expectedReturn DateTime
  returnedAt     DateTime?
  location       String?
  notes          String?
  status         RentalStatus @default(DRAFT)
  tenantUuid     String

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  rentalItems RentalItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantUuid, rentalCode])
  @@index([clientId])
  @@index([tenantUuid])
  @@map("rentals")
}

model RentalItem {
  id               String @id @default(uuid())
  quantity         Int
  returnedQuantity Int    @default(0)
  tenantUuid       String

  rentalId String
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rentalId, itemId])
  @@index([rentalId])
  @@index([itemId])
  @@index([tenantUuid])
  @@map("rental_items")
}

// NOVA TABELA: Divergências
model Divergence {
  id          String           @id @default(uuid())
  quantity    Int              // Quantidade que faltou ou quebrou
  type        DivergenceType   // MISSING (Faltou) ou DAMAGED (Danificado)
  status      DivergenceStatus @default(PENDING) // Começa como pendente de resolução
  notes       String?          // Observações (Ex: "Cadeira quebrou a perna traseira")
  tenantUuid        String

  eventItemId String
  eventItem   EventItem @relation(fields: [eventItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventItemId])
  @@map("divergences")
}
