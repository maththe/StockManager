generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================

enum EventStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RentalStatus {
  DRAFT
  ACTIVE
  RETURNED
  CANCELLED
}

// Define se a divergência foi porque sumiu ou porque quebrou
enum DivergenceType {
  MISSING
  DAMAGED
}

// Define se a divergência já foi resolvida (ex: cliente pagou pela cadeira quebrada)
enum DivergenceStatus {
  PENDING
  RESOLVED
}

// Origem da divergência. sourceId aponta para a entidade correspondente.
enum DivergenceSource {
  EVENT
  RENTAL
  MANUAL
  MAINTENANCE
}

enum UserRole {
  ADMIN
  DECORADOR
  FUNCIONARIO
}

enum TaskStatus {
  PENDENTE
  CONCLUIDA
  CANCELADA
}

enum TaskType {
  SAIDA_GALPAO
  ENTRADA_GALPAO
}

enum MaintenanceStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum MaintenanceType {
  REPARO
  LIMPEZA
  PINTURA
  COSTURA
  ELETRICA
  OUTRA
}

// ================= MODELS =================

model User {
  id                   String        @id @default(uuid())
  name                 String
  email                String        @unique
  password             String
  tenantUuid           String        @default(uuid())
  role                 UserRole      @default(FUNCIONARIO)
  responsibleEvents    Event[]       @relation("EventResponsible")
  divergencesCreated   Divergence[]  @relation("DivergenceCreator")
  divergencesResolved  Divergence[]  @relation("DivergencesResolved")
  tasksAssigned        Task[]        @relation("TasksAssigned")
  tasksCreated         Task[]        @relation("TasksCreated")
  maintenancesAssigned Maintenance[] @relation("MaintenancesAssigned")
  maintenancesCreated  Maintenance[] @relation("MaintenancesCreated")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  tenantUuid  String
  items       Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantUuid])
  @@map("categories")
}

model Client {
  id          String   @id @default(uuid())
  companyName String
  taxId       String
  contactName String?
  tenantUuid  String
  events      Event[]
  rentals     Rental[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantUuid, taxId])
  @@index([tenantUuid])
  @@map("clients")
}

model Item {
  id                String   @id @default(uuid())
  name              String
  totalQuantity     Int      @default(0)
  availableQuantity Int      @default(0)
  unitCost          Decimal  @db.Decimal(10, 2)
  tenantUuid        String

  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  imageUrl          String?  @map("image_url")

  eventItems      EventItem[]
  rentalItems     RentalItem[]
  divergenceItems DivergenceItem[]
  maintenances    Maintenance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([tenantUuid])
  @@map("items")
}

model Event {
  id            String      @id @default(uuid())
  eventName     String
  startDate     DateTime
  endDate       DateTime?
  eventLocation String
  status        EventStatus @default(PLANNING)
  tenantUuid    String

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  responsibleId String?
  responsible   User?       @relation("EventResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  eventItems EventItem[]
  tasks      Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([responsibleId])
  @@map("events")
}

model EventItem {
  id               String   @id @default(uuid())
  plannedQuantity  Int
  shippedQuantity  Int      @default(0)
  returnedQuantity Int      @default(0)
  tenantUuid        String

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  taskItems TaskItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, itemId])
  @@index([eventId])
  @@index([itemId])
  @@map("event_items")
}

model Rental {
  id             String       @id @default(uuid())
  rentalCode     String
  startDate      DateTime
  expectedReturn DateTime
  returnedAt     DateTime?
  location       String?
  notes          String?
  status         RentalStatus @default(DRAFT)
  tenantUuid     String

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  rentalItems RentalItem[]
  tasks       Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantUuid, rentalCode])
  @@index([clientId])
  @@index([tenantUuid])
  @@map("rentals")
}

model RentalItem {
  id               String @id @default(uuid())
  quantity         Int
  returnedQuantity Int    @default(0)
  tenantUuid       String

  rentalId String
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  taskItems TaskItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rentalId, itemId])
  @@index([rentalId])
  @@index([itemId])
  @@index([tenantUuid])
  @@map("rental_items")
}

// Divergência (header): representa a ocorrência/ato.
// sourceId aponta para Event/Rental conforme `source`; null em MANUAL/MAINTENANCE.
model Divergence {
  id           String           @id @default(uuid())
  source       DivergenceSource
  sourceId     String?
  status       DivergenceStatus @default(PENDING)
  notes        String?
  occurredAt   DateTime         @default(now())
  tenantUuid   String
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?            @relation("DivergencesResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("DivergenceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  items        DivergenceItem[]
  maintenances Maintenance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantUuid, source])
  @@index([source, sourceId])
  @@map("divergences")
}

// Linha da divergência: o que faltou/quebrou de cada item dentro daquela ocorrência.
// sourceItemId aponta para EventItem/RentalItem conforme `divergence.source`; null em MANUAL/MAINTENANCE.
model DivergenceItem {
  id         String         @id @default(uuid())
  quantity   Int
  type       DivergenceType
  notes      String?
  tenantUuid String

  divergenceId String
  divergence   Divergence @relation(fields: [divergenceId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  sourceItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([divergenceId])
  @@index([itemId])
  @@index([sourceItemId])
  @@map("divergence_items")
}

// Tarefa de confirmação de movimentação no galpão.
// Vinculada a um Event OU a um Rental (exatamente uma das duas origens).
// SAIDA_GALPAO: itens saindo do galpão. ENTRADA_GALPAO: itens retornando.
// Eventos criam automaticamente (iniciar/concluir); locações geram sob demanda.
model Task {
  id           String     @id @default(uuid())
  code         String
  type         TaskType   @default(SAIDA_GALPAO)
  status       TaskStatus @default(PENDENTE)
  notes        String?
  tenantUuid   String
  completedAt  DateTime?

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  rentalId String?
  rental   Rental? @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("TasksAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("TasksCreated", fields: [createdById], references: [id], onDelete: SetNull)

  taskItems TaskItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantUuid, code])
  @@index([tenantUuid])
  @@index([eventId])
  @@index([rentalId])
  @@map("tasks")
}

model TaskItem {
  id                String  @id @default(uuid())
  requestedQuantity Int     @default(0)
  confirmedQuantity Int     @default(0)
  confirmed         Boolean @default(false)
  notes             String?
  tenantUuid        String

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  eventItemId String?
  eventItem   EventItem? @relation(fields: [eventItemId], references: [id], onDelete: Cascade)

  rentalItemId String?
  rentalItem   RentalItem? @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([eventItemId])
  @@index([rentalItemId])
  @@map("task_items")
}

// Registro de manutenção de item.
// divergenceId != null → gerado automaticamente de itens DAMAGED em divergência.
// divergenceId == null → criado manualmente; neste caso availableQuantity foi decrementado na criação.
model Maintenance {
  id           String            @id @default(uuid())
  code         String
  status       MaintenanceStatus @default(PENDENTE)
  type         MaintenanceType   @default(OUTRA)
  quantity     Int
  notes        String?
  tenantUuid   String
  completedAt  DateTime?

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  divergenceId String?
  divergence   Divergence? @relation(fields: [divergenceId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("MaintenancesAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("MaintenancesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantUuid, code])
  @@index([tenantUuid])
  @@index([itemId])
  @@map("maintenances")
}
