# Copie para .env e preencha. Nenhuma destas variáveis tem valor padrão seguro.

# Postgres. Na Render, use a "Internal Database URL" (mesma região, sem sair
# para a internet). Fora da Render, a External exige ?sslmode=require.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/stockmanager

# Segredo de assinatura do JWT. A API não sobe sem ele.
# Gere um valor aleatório: openssl rand -base64 48
JWT_SECRET=

# Porta HTTP. Na Render é injetada automaticamente — não defina lá.
PORT=3000

# Origens liberadas no CORS, separadas por vírgula. Em produção, aponte para o
# domínio do front na Vercel. Vazio = reflete qualquer origem (só para dev).
# CORS_ORIGINS=https://stockmanager.vercel.app
